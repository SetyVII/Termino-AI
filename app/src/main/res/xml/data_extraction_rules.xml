<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="termino.db" />
        <include domain="file" path="books/" />
        <exclude domain="sharedpref" path="termino_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="termino.db" />
        <include domain="file" path="books/" />
        <exclude domain="sharedpref" path="termino_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
