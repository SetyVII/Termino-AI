<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- BYOK providers such as Ollama frequently run on a LAN address over HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
